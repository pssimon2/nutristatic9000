{
  "name": "nutristatic9000",
  "version": "0.1.0",
  "description": "Client-side rewrite of Nutrimatic: pattern search over a phrase-frequency index, no server-side code",
  "type": "module",
  "license": "GPL-2.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build-docs": "tsx scripts/build-docs.mjs",
    "build-head": "tsx scripts/build-head.mjs",
    "check-docs": "tsx scripts/build-docs.mjs --check",
    "check-layers": "node scripts/check-layers.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-examples": "tsx scripts/check-examples.mjs",
    "deploy": "node scripts/deploy.mjs",
    "bench": "tsx scripts/bench.mjs",
    "bench:update": "tsx scripts/bench.mjs --update",
    "dev": "vite web --port 5174",
    "build": "vite build web",
    "postbuild": "node scripts/build-offline.mjs && node scripts/build-sw.mjs",
    "preview": "vite preview web --port 4318",
    "find-expr": "tsx cli/find-expr.ts",
    "make-index": "tsx cli/make-index.ts",
    "merge-indexes": "tsx cli/merge-indexes.ts",
    "dump-index": "tsx cli/dump-index.ts",
    "wordlist-index": "tsx cli/wordlist-index.ts",
    "compress-index": "tsx cli/compress-index.ts",
    "build-wasm": "clang --target=wasm32-unknown-unknown -O3 -nostdlib -Wl,--no-entry -Wl,--export-dynamic -Wl,--allow-undefined -Wl,--initial-memory=17039360 -Wl,--max-memory=3221225472 -o wasm-kernel/kernel.wasm wasm-kernel/kernel.c",
    "build-offline": "node scripts/build-offline.mjs",
    "test:browser": "sh scripts/browser-test.sh",
    "test:offline": "node scripts/offline-test.mjs",
    "check-head": "tsx scripts/check-head.mjs",
    "check-deployed": "tsx scripts/check-deployed.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    "./engine": "./src/engine.ts"
  }
}
