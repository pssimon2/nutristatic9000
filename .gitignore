node_modules/
web/dist/
# Head sidecars, built from the big indexes and copied into web/dist/ at
# deploy time. Kept OUTSIDE dist so a rebuild + `rsync --delete` cannot
# silently drop them from the server — which is exactly what happened once.
web/heads/

# Build workspace: dumps, chunks, merged indexes (see README to rebuild)
data/

# Compiled C++ reference tools (see nutrimatic/ and tools/; rebuild with g++)
build-cpp/

# Nutrimatic clone, kept for reference and the C++ sources
nutrimatic/

# Generated index artifacts served by the web app (rebuild via npm scripts)
# The big Wikipedia indexes are downloaded/built, not committed — except the
# small demo index, which the dev server and the test suite depend on.
web/public/*.index
web/public/*.idxz
!web/public/demo.index

*.log

# Scratch screenshots from browser tests
/*.png

# Ralph-loop / Claude session state
.claude/

# Generated self-contained offline build (npm run build-offline)
web/dist-offline/
